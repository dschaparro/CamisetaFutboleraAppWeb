# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local al repositorio.

# Settings → General (o Connect): Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Settings → API Keys → Secret keys (sb_secret_...). Solo servidor.
# https://supabase.com/docs/guides/getting-started/api-keys
SUPABASE_SECRET_KEY=sb_secret_pega_aqui

# Settings → API Keys → Publishable key (sb_publishable_...). Para el cliente más adelante.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pega_aqui

# JWT del panel: lo genera Next.js, NO uses "JWT Keys" de Supabase.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia_esto_por_64_hex_o_mas

# Postgres (pooler sesión Supabase). Obligatorio si DATOS_SIMULADOS no es true.
# Settings → Database → Connection string (URI), modo Session / Transaction según tu red.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres

# API de Claude (Anthropic) — chat e informes. Solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Se crea en https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=sk-ant-pega_aqui
# Opcional: cambia el modelo sin tocar código (por defecto claude-sonnet-5).
# ANTHROPIC_MODEL=claude-sonnet-5

# true = cuentas, clientes, tienda y pedidos en memoria (pruebas sin BD).
# DATOS_SIMULADOS=true

# true = saltarse el login del panel (solo desarrollo local).
# DEV_BYPASS_AUTH=false

# --- Producto / ops (ver docs/ops-producto.md) ---

# Wompi (pasarela). Sin WOMPI_USE_REAL se usa la pasarela simulada.
# WOMPI_USE_REAL=false
# WOMPI_PUBLIC_KEY=pub_test_...
# WOMPI_PRIVATE_KEY=prv_test_...
# WOMPI_INTEGRITY_SECRET=...
# WOMPI_EVENTS_SECRET=...

# Supabase Storage (imágenes fuera de bytea). Opcional mientras se use Postgres.
# SUPABASE_STORAGE_BUCKET=productos

# Correo transaccional (pedido / factura). Stub si no hay clave.
# RESEND_API_KEY=re_...
# CORREO_FROM="Camiseta Futbolera <noreply@tudominio.com>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
