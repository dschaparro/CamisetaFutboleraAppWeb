# Copia este archivo a .env.local y completa los valores reales.
# .env.local NUNCA se sube al repositorio (ya está en .gitignore).

# --- Supabase (Auth, PostgreSQL, Storage) ---
# Sprint 0 del Tablero de Sprints: proyecto de desarrollo YA CREADO.
# Panel del proyecto en supabase.com > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Wompi (pasarela de pago) ---
# Sprint 0: "no iniciado, se necesita a partir del Sprint 3". Usar llaves
# de sandbox mientras tanto: https://comercios.wompi.co
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=

# --- API de Claude (Anthropic) — asistente conversacional e informes con IA ---
# Sprint 0: "no iniciado — lo necesita el prototipo de IA de este mismo sprint".
# Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Correo transaccional (factura, notificaciones) ---
RESEND_API_KEY=
